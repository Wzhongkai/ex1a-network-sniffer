<Window x:Class="Sniffer.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:Sniffer.Core;assembly=Sniffer.Core"
        Title="网络嗅探器 · 实验 1A" Width="1280" Height="840" MinWidth="960" MinHeight="640"
        Background="#F2F6FB" Foreground="{StaticResource Ink}" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="13"
        UseLayoutRounding="True" WindowStartupLocation="CenterScreen" Loaded="OnLoaded" Closing="OnClosing">
    <Window.Resources>
        <Style x:Key="PacketAddress" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height=".67*"/>
            <RowDefinition Height="32"/>
        </Grid.RowDefinitions>

        <Border Background="#112844" Margin="20,12,20,0" Padding="18,13" CornerRadius="7">
            <DockPanel LastChildFill="True" VerticalAlignment="Center">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="DemoButton" Content="载入演示流量" Click="OnDemo" Margin="0,0,8,0"/>
                    <Button x:Name="OpenButton" Content="打开抓包" Click="OnOpen" Margin="0,0,8,0"/>
                    <Button x:Name="SaveButton" Content="保存抓包" Click="OnSave" IsEnabled="False"/>
                    <Button Content="连接汇总" Margin="8,0,0,0" Click="OnConnections"/>
                    <Button Content="显示设置" Margin="8,0,0,0" Click="OnDisplaySettings"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="40" Height="40" Background="#1B4776" CornerRadius="7" Margin="0,0,12,0">
                        <Path Width="27" Height="21" Stretch="Uniform" Stroke="#8DD7FF" StrokeThickness="2"
                              Data="M 0,10 L 5,10 8,3 12,18 16,6 19,10 26,10"/>
                    </Border>
                    <TextBlock Text="网络嗅探器" FontSize="25" FontWeight="SemiBold" Foreground="#F5FAFF" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Padding="0,10" Margin="20,3,20,0" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="接口" Margin="0,0,9,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <ComboBox x:Name="InterfacesBox" Grid.Column="1" MinWidth="150" Height="33" VerticalContentAlignment="Center"
                          ToolTip="选择要捕获的网络接口">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel LastChildFill="True">
                                <Image DockPanel.Dock="Right" Width="54" Height="18" Margin="8,0,0,0"
                                       Source="{Binding Chart}" ToolTip="{Binding Rate}"/>
                                <TextBlock Text="{Binding Interface.Name}" TextTrimming="CharacterEllipsis"/>
                            </DockPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button x:Name="RefreshButton" Grid.Column="2" Content="刷新" Margin="7,0,15,0" Click="OnRefresh"/>
                <TextBlock Grid.Column="3" Text="采集筛选" Margin="0,0,8,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                <TextBox x:Name="CaptureFilterBox" Grid.Column="4" MaxLength="512" Height="33"
                         AutomationProperties.Name="捕获过滤" ToolTip="例如 tcp and port 8080。留空捕获接口上的所有可见报文。"/>
                <Button x:Name="StartButton" Grid.Column="5" Style="{StaticResource Primary}" Content="开始捕获" Margin="9,0,6,0" Click="OnStart"/>
                <Button x:Name="StopButton" Grid.Column="6" Content="停止" IsEnabled="False" Click="OnStop"/>
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="20,10,20,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Margin="0,0,15,0">
                <TextBlock Text="协议筛选" Margin="0,0,8,0" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <ComboBox x:Name="ProtocolFilterBox" Width="105" Height="33" VerticalContentAlignment="Center"
                          AutomationProperties.Name="协议筛选" SelectionChanged="OnProtocolChanged">
                    <ComboBoxItem Content="全部协议" Tag=""/>
                    <ComboBoxItem Content="HTTP" Tag="http"/>
                    <ComboBoxItem Content="DNS" Tag="dns"/>
                    <ComboBoxItem Content="TLS" Tag="tls"/>
                    <ComboBoxItem Content="TCP" Tag="tcp"/>
                    <ComboBoxItem Content="UDP" Tag="udp"/>
                    <ComboBoxItem Content="IPv4" Tag="ipv4"/>
                    <ComboBoxItem Content="IPv6" Tag="ipv6"/>
                    <ComboBoxItem Content="ICMP" Tag="icmp || icmpv6"/>
                    <ComboBoxItem Content="ICMPv4" Tag="icmp"/>
                    <ComboBoxItem Content="ICMPv6" Tag="icmpv6"/>
                    <ComboBoxItem Content="ARP" Tag="arp"/>
                </ComboBox>
            </StackPanel>
            <TextBlock Grid.Column="1" Text="显示表达式" Margin="0,0,8,0" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <TextBox x:Name="DisplayFilterBox" Grid.Column="2" MaxLength="512" Height="33"
                     AutomationProperties.Name="显示过滤" KeyDown="OnFilterKey"
                     ToolTip="例如 ipv6 &amp;&amp; (tcp || icmpv6)、http、port == 8080、pid == 1234"/>
            <Button Grid.Column="3" Content="应用" Margin="7,0,6,0" Click="OnApplyFilter"/>
            <Button Grid.Column="4" Content="清除" Margin="0,0,10,0" Click="OnClearFilter"/>
            <Button x:Name="FollowButton" Grid.Column="5" Content="跟踪所选 TCP 流" IsEnabled="False" Margin="0,0,6,0" Click="OnFollow"/>
            <Button Grid.Column="6" Content="会话与进程" Click="OnFlows"/>
        </Grid>

        <Grid Grid.Row="3" Margin="20,0">
            <DataGrid x:Name="PacketGrid" SelectionChanged="OnPacketSelected" AutoGenerateColumns="False"
                      MouseDoubleClick="OnPacketDoubleClick">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="{Binding Color}"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#CCE5FF"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="#" Binding="{Binding Number}" Width="56"/>
                    <DataGridTextColumn Header="时间" Binding="{Binding TimeText}" Width="125"/>
                    <DataGridTextColumn Header="源地址 / 端口" Binding="{Binding SourceText}" Width="1.12*"
                                        ElementStyle="{StaticResource PacketAddress}"/>
                    <DataGridTextColumn Header="目标地址 / 端口" Binding="{Binding DestinationText}" Width="1.12*"
                                        ElementStyle="{StaticResource PacketAddress}"/>
                    <DataGridTextColumn Header="协议" Binding="{Binding Protocol}" Width="78"/>
                    <DataGridTextColumn Header="长度" Binding="{Binding Raw.WireLength}" Width="60"/>
                    <DataGridTextColumn Header="摘要" Binding="{Binding Info}" Width="2.15*"/>
                    <DataGridTextColumn Header="进程" Binding="{Binding ProcessText}" Width="1*"/>
                </DataGrid.Columns>
            </DataGrid>
            <Border x:Name="EmptyState" Margin="1,34,1,1" Background="White" IsHitTestVisible="False">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10">
                    <TextBlock x:Name="EmptyTitle" Text="选择接口后开始捕获" FontSize="20" FontWeight="SemiBold" TextAlignment="Center"/>
                    <TextBlock Text="也可打开 PCAP / PCAPNG 或载入演示流量" Margin="0,7,0,0"
                               Foreground="{StaticResource Muted}" TextAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
        <GridSplitter Grid.Row="4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="20,1"
                      Background="Transparent" ShowsPreview="True"/>

        <Grid Grid.Row="5" Margin="20,0,20,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.05*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="1.25*"/>
            </Grid.ColumnDefinitions>
            <Border Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#EDF3FA" Padding="9,6">
                        <TextBlock Text="协议详情" FontWeight="SemiBold"/>
                    </Border>
                    <TreeView x:Name="DetailsTree" BorderThickness="0" Padding="3" SelectedItemChanged="OnFieldSelected">
                        <TreeView.Resources>
                            <HierarchicalDataTemplate DataType="{x:Type core:PacketLayer}" ItemsSource="{Binding Fields}">
                                <TextBlock Text="{Binding Label}" FontWeight="SemiBold"/>
                            </HierarchicalDataTemplate>
                            <DataTemplate DataType="{x:Type core:PacketField}">
                                <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"/>
                            </DataTemplate>
                        </TreeView.Resources>
                    </TreeView>
                </DockPanel>
            </Border>
            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent"/>
            <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="1">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#EDF3FA" Padding="9,4">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button x:Name="PrevPage" Click="OnPreviousPage" Content="‹" MinHeight="23" Padding="9,0" ToolTip="上一页"/>
                                <TextBlock x:Name="HexPage" Text="—" MinWidth="72" TextAlignment="Center" VerticalAlignment="Center"/>
                                <Button x:Name="NextPage" Click="OnNextPage" Content="›" MinHeight="23" Padding="9,0" ToolTip="下一页"/>
                            </StackPanel>
                            <TextBlock Text="原始字节 · HEX / ASCII" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>
                    <RichTextBox x:Name="HexBox" IsReadOnly="True" BorderThickness="0" FontFamily="Consolas" FontSize="12"
                                 Padding="7,3" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"/>
                </DockPanel>
            </Border>
        </Grid>

        <Border Grid.Row="6" Background="#E7EFF9" Padding="20,0">
            <DockPanel LastChildFill="True">
                <TextBlock x:Name="CounterText" DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0"/>
                <TextBlock x:Name="StatusText" Text="就绪" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
